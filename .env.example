# Copia este archivo a `.env` para desarrollo local (`npm run dev`).
# `.env` está en .gitignore. En producción, estos valores se cargan con
# `npx wrangler secret put NOMBRE` (ver README), nunca en wrangler.jsonc.

# --- Google Calendar (Google Cloud Console → Credenciales → ID de cliente OAuth "Aplicación web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- TickTick (developer.ticktick.com/manage)
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
# Opcional: token personal (TickTick → Ajustes → Cuenta → API Token).
# Solo se usa si no hay un token OAuth guardado.
TICKTICK_API_TOKEN=

# --- Cifrado de tokens en KV (32 bytes en base64). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Cloudflare Access (solo producción; en local se ignora con DEV_MODE=true).
# Dominio del equipo de Zero Trust, p. ej. https://mi-equipo.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" de la aplicación de Access.
ACCESS_AUD=
# Correos autorizados, separados por comas.
ALLOWED_EMAILS=

# --- Solo desarrollo local. Se ignoran salvo que la petición llegue a localhost/127.0.0.1.
# Salta la validación de Access en local.
DEV_MODE=true
# Sirve datos de ejemplo (fixtures) en lugar de llamar a Google/TickTick.
MOCK_DATA=false
